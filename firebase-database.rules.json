{
  "rules": {
    ".read": false,
    ".write": false,
    "inviteCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && newData.isString()"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "profile": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "savedRooms": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "activeRoom": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "roomMemberships": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "personalExpenses": {
          "$expenseId": {
            ".write": "auth != null && auth.uid == $uid && (!data.exists() || data.child('memberUid').val() == auth.uid)"
          }
        },
        "personalNotes": {
          "$noteId": {
            ".write": "auth != null && auth.uid == $uid && (!data.exists() || data.child('authorUid').val() == auth.uid)"
          }
        }
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        "info": {
          ".write": "auth != null && (!data.exists() || root.child('rooms').child($roomId).child('info').child('createdBy').val() == auth.uid)"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && (!data.exists() || data.child('uid').val() == auth.uid)"
          }
        },
        "expenses": {
          "$expenseId": {
            ".write": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists() && (!data.exists() || data.child('memberUid').val() == auth.uid)"
          }
        },
        "notes": {
          "$noteId": {
            ".write": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists() && (!data.exists() || data.child('authorUid').val() == auth.uid)"
          }
        }
      }
    }
  }
}